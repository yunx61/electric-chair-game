{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null && (data.child('meta/host/uid').val() === auth.uid || data.child('meta/guest/uid').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('meta/schemaVersion').val() === 1 && newData.child('meta/roomId').val() === $roomId && newData.child('meta/host/uid').val() === auth.uid && newData.child('meta/createdAt').isNumber() && newData.child('meta/createdAt').val() <= now && newData.child('meta/createdAt').val() >= now - 10000 && !newData.child('meta/guest').exists() && !newData.child('game').exists() && !newData.child('presence').exists()) || (data.exists() && !newData.exists() && data.child('meta/host/uid').val() === auth.uid && !data.child('meta/guest').exists()))",
        ".validate": "newData.hasChildren(['meta'])",
        "meta": {
          ".validate": "newData.hasChildren(['schemaVersion', 'roomId', 'createdAt', 'host'])",
          "schemaVersion": { ".validate": "newData.val() === 1 && (!data.exists() || newData.val() === data.val())" },
          "roomId": { ".validate": "newData.isString() && newData.val() === $roomId && newData.val().matches(/^[A-Za-z0-9_-]{22}$/) && (!data.exists() || newData.val() === data.val())" },
          "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
          "host": {
            ".validate": "newData.hasChildren(['uid', 'name']) && (!data.exists() || newData.val() === data.val())",
            "uid": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,128}$/)" },
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 32" },
            "$other": { ".validate": false }
          },
          "guest": {
            ".read": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || root.child('rooms').child($roomId).child('meta/host/uid').val() === auth.uid)",
            ".write": "auth != null && !data.exists() && newData.exists() && newData.child('uid').val() === auth.uid && root.child('rooms').child($roomId).child('meta/host/uid').val() !== auth.uid",
            ".validate": "newData.hasChildren(['uid', 'name', 'joinedAt'])",
            "uid": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,128}$/)" },
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 32" },
            "joinedAt": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 10000" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (root.child('rooms').child($roomId).child('meta/host/uid').val() === auth.uid || root.child('rooms').child($roomId).child('meta/guest/uid').val() === auth.uid) && newData.exists()",
            ".validate": "newData.hasChildren(['state', 'lastChanged'])",
            "state": { ".validate": "newData.isString() && (newData.val() === 'online' || newData.val() === 'offline')" },
            "lastChanged": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 10000" },
            "$other": { ".validate": false }
          }
        },
        "game": {
          "meta": {
            ".write": "auth != null && !data.exists() && newData.exists() && root.child('rooms').child($roomId).child('meta/host/uid').val() === auth.uid && root.child('rooms').child($roomId).child('meta/guest/uid').isString()",
            ".validate": "newData.hasChildren(['schemaVersion', 'matchId', 'createdAt'])",
            "schemaVersion": { ".validate": "newData.val() === 1" },
            "matchId": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{22}$/)" },
            "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 10000" },
            "$other": { ".validate": false }
          },
          "turns": {
            "$turn": {
              "commit": {
                ".write": "auth != null && !data.exists() && newData.exists() && root.child('rooms').child($roomId).child('game/meta').exists() && (($turn.matches(/^h[0-9]{6}$/) && root.child('rooms').child($roomId).child('meta/host/uid').val() === auth.uid) || ($turn.matches(/^g[0-9]{6}$/) && root.child('rooms').child($roomId).child('meta/guest/uid').val() === auth.uid))",
                ".validate": "newData.hasChildren(['uid', 'hash', 'at'])",
                "uid": { ".validate": "newData.val() === auth.uid" },
                "hash": { ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{64}$/)" },
                "at": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 10000" },
                "$other": { ".validate": false }
              },
              "choice": {
                ".write": "auth != null && !data.exists() && newData.exists() && root.child('rooms').child($roomId).child('game/turns').child($turn).child('commit').exists() && (($turn.matches(/^h[0-9]{6}$/) && root.child('rooms').child($roomId).child('meta/guest/uid').val() === auth.uid) || ($turn.matches(/^g[0-9]{6}$/) && root.child('rooms').child($roomId).child('meta/host/uid').val() === auth.uid))",
                ".validate": "newData.hasChildren(['uid', 'seat', 'at'])",
                "uid": { ".validate": "newData.val() === auth.uid" },
                "seat": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 12" },
                "at": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 10000" },
                "$other": { ".validate": false }
              },
              "reveal": {
                ".write": "auth != null && !data.exists() && newData.exists() && root.child('rooms').child($roomId).child('game/turns').child($turn).child('choice').exists() && (($turn.matches(/^h[0-9]{6}$/) && root.child('rooms').child($roomId).child('meta/host/uid').val() === auth.uid) || ($turn.matches(/^g[0-9]{6}$/) && root.child('rooms').child($roomId).child('meta/guest/uid').val() === auth.uid))",
                ".validate": "newData.hasChildren(['uid', 'seat', 'nonce', 'at'])",
                "uid": { ".validate": "newData.val() === auth.uid" },
                "seat": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 12" },
                "nonce": { ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32,128}$/)" },
                "at": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 10000" },
                "$other": { ".validate": false }
              },
              "forfeit": {
                ".write": "auth != null && !data.exists() && newData.exists() && !root.child('rooms').child($roomId).child('game/turns').child($turn).child('reveal').exists() && root.child('rooms').child($roomId).child('game/turns').child($turn).child('choice/at').val() + 90000 <= now && (($turn.matches(/^h[0-9]{6}$/) && root.child('rooms').child($roomId).child('meta/guest/uid').val() === auth.uid) || ($turn.matches(/^g[0-9]{6}$/) && root.child('rooms').child($roomId).child('meta/host/uid').val() === auth.uid))",
                ".validate": "newData.hasChildren(['uid', 'reason', 'at'])",
                "uid": { ".validate": "newData.val() === auth.uid" },
                "reason": { ".validate": "newData.val() === 'reveal_timeout'" },
                "at": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 10000" },
                "$other": { ".validate": false }
              },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
